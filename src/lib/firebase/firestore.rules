rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Oracle Spreads & Reading Sessions
    match /users/{userId}/oracle_spreads/{spreadId} {
      allow read, write: if isOwner(userId);
    }

    // Memory Codex Fragments
    match /codex_fragments/{fragmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Public Intelligence Briefings
    match /briefings/{briefingId} {
      allow read: if true;
      allow write: if false; // Read-only for clients
    }
  }
}
