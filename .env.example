# ==============================================================================
# Guardian Oracle - Environment Configuration Example
# ==============================================================================
# COPY THIS FILE TO .env OR .env.local BEFORE RUNNING LOCALLY:
#   cp .env.example .env
#
# NEVER COMMIT YOUR REAL .env FILE OR ANY PRIVATE KEYS TO GITHUB.
# All real secrets in .env are ignored by git via .gitignore.
# ==============================================================================

# Node / Server Configuration
NODE_ENV=development
PORT=3000

# Google Gemini API Key (Required for live AI forecast and Ember UR chat)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional - for persistent cloud storage and authentication)
# Client-side (Vite prefix)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Server-side Firebase Admin (Optional)
FIREBASE_PROJECT_ID=your_project_id

# Stripe Payments & Webhooks (Optional - for Tier subscriptions)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
STRIPE_PRICE_EXPLORER=price_placeholder_explorer_tier
STRIPE_PRICE_LUMINARY=price_placeholder_luminary_tier

# Web3 / Polygon Network Configuration (Optional overrides)
# Polygon Mainnet (137) or Polygon Amoy Testnet (80002)
VITE_POLYGON_CHAIN_ID=137
VITE_IGNIS_CONTRACT_ADDRESS=0x71cA4918eEb645bc25E29699A3144df8555Ef4b3
